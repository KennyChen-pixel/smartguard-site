# 依賴套件（npm install 會自動產生，不需上傳）
node_modules/

# 建置輸出（部署平台會自己跑 build）
dist/

# 環境變數與金鑰（絕不可進 git）
.env
.env.*
!.env.example

# Vercel 本機連結設定
.vercel

# Claude Code 本機設定（含個人路徑與權限）與 skill 快取；.claude/commands/ 需要進 git
.claude/settings.local.json
.claude/skills/
skills-lock.json

# 內部文件（營運計畫簡報等，不可公開）
*.pptx
*.pdf

# Astro 產生的型別快取
.astro/

# Playwright 截圖與暫存
.playwright-mcp/

# 系統與編輯器暫存
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
