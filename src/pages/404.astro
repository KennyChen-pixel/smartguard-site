---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import site from '../../content/site.json';
---
<BaseLayout title={`找不到這個頁面｜${site.name}`} description="您要找的頁面不存在或已移動。" noindex>
  <section class="nf paper-grid">
    <div class="container inner">
      <p class="code mono" aria-hidden="true">404</p>
      <h1 class="display">找不到這個頁面</h1>
      <p class="lede">您要找的頁面可能已移動或不存在。可以回到首頁，或從下方前往其他頁面。</p>
      <div class="ctas">
        <a class="btn btn-primary" href="/">回到首頁<Icon name="ArrowRight" /></a>
        <a class="btn btn-ghost" href="/contact">聯絡我們</a>
      </div>
      <ul class="links">
        {site.nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
<style>
  .nf { min-height: 70vh; display: grid; place-items: center; padding-block: 96px; text-align: center; }
  .inner { display: flex; flex-direction: column; align-items: center; }
  .code { font-size: clamp(4rem, 14vw, 9rem); font-weight: 500; line-height: 1; background: var(--brand-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
  h1 { margin-top: 16px; font-size: clamp(1.8rem, 4vw, 2.8rem); }
  .lede { margin-inline: auto; }
  .ctas { margin-top: 28px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .links { list-style: none; padding: 0; margin-top: 32px; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 20px; }
  .links a { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; min-width: 48px; padding: 0 8px; color: var(--cyan-ink); font-weight: 500; }
</style>
