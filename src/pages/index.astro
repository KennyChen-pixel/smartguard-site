---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import SectionHead from '../components/SectionHead.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import PreventionTimeline from '../components/PreventionTimeline.astro';
import SignalChart from '../components/SignalChart.astro';
import NewsList from '../components/NewsList.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import home from '../../content/home.json';
import product from '../../content/product.json';
import tech from '../../content/technology.json';
import team from '../../content/team.json';
import { getImage } from '../lib/images';
const teamPhoto = getImage(team.photo.image);
---
<BaseLayout title={home.seo.title} description={home.seo.description} product headerOverlay>
  <Hero />
  <TrustBar />

  <!-- 核心技術（深色） -->
  <section class="section on-deep tech">
    <div class="container">
      <SectionHead eyebrow={home.techIntro.eyebrow} title={home.techIntro.title} body={home.techIntro.body} />
      <div class="feat-wrap">
        <FeatureGrid items={product.features} tone="deep" />
      </div>
      <a class="btn btn-ghost more" href="/product" data-reveal>了解產品<Icon name="ArrowRight" /></a>
    </div>
  </section>

  <!-- 事前防護 -->
  <section class="section paper-grid prevent">
    <div class="container two">
      <div>
        <div data-reveal>
          <p class="eyebrow">WHY SMARTGUARD</p>
          <h2 class="h2">{tech.comparison.title}<br /><span class="hl">{tech.comparison.highlight}</span></h2>
        </div>
        <ul class="points">
          {tech.comparison.points.map((p, i) => (
            <li data-reveal style={`--d:${i * 0.1}s`}>
              <span class="pi"><Icon name={p.icon} size={20} /></span>
              <span>{p.text}</span>
            </li>
          ))}
        </ul>
        <a class="btn btn-link" href="/technology" data-reveal>了解核心技術</a>
      </div>
      <div class="viz">
        <PreventionTimeline />
        <div data-reveal><SignalChart /></div>
      </div>
    </div>
  </section>

  <!-- 最新消息 -->
  <section class="section news">
    <div class="container narrow">
      <SectionHead eyebrow={home.newsIntro.eyebrow} title={home.newsIntro.title} />
      <div class="list"><NewsList limit={3} /></div>
      <a class="btn btn-ghost" href="/news" data-reveal>查看全部消息<Icon name="ArrowRight" /></a>
    </div>
  </section>

  <!-- 關於我們（導讀） -->
  <section class="section about paper-grid">
    <div class="container two">
      <div data-reveal>
        <p class="eyebrow">{team.about.eyebrow}</p>
        <h2 class="h2">{team.about.title}</h2>
        <blockquote><p>「{team.about.quote}」</p></blockquote>
        <a class="btn btn-link" href="/team">認識我們的團隊</a>
      </div>
      <figure class="photo" data-reveal style="--d:.15s">
        <Image src={teamPhoto} alt={team.photo.alt} widths={[480, 720, 960]} sizes="(max-width: 900px) 92vw, 520px" />
        <figcaption>{team.photo.caption}</figcaption>
      </figure>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .tech { overflow: hidden; }
  .tech::before { content: ""; position: absolute; inset: 0; pointer-events: none; background: radial-gradient(50vw 50vh at 100% 0%, rgba(79, 192, 225, 0.16), transparent 70%); }
  .tech .container { position: relative; }
  .feat-wrap { margin-top: clamp(40px, 5vw, 64px); }
  .more { margin-top: 40px; }

  .two { display: grid; gap: clamp(40px, 6vw, 80px); align-items: center; }
  @media (min-width: 960px) { .two { grid-template-columns: 1fr 1.1fr; } }
  .hl { background: linear-gradient(120deg, #0d6a86, #1b6f5b); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .points { list-style: none; padding: 0; margin: 32px 0 20px; display: grid; gap: 18px; }
  .points li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; color: var(--ink); }
  .pi { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--surface); border: 1px solid rgba(79, 192, 225, 0.4); color: var(--cyan-ink); }
  .viz { display: grid; gap: 18px; }

  .narrow { max-width: calc(880px + var(--gutter) * 2); }
  .list { margin: 44px 0 36px; }

  blockquote { margin: 28px 0 18px; padding-left: 20px; border-left: 3px solid; border-image: var(--brand-grad) 1; }
  blockquote p { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.15rem, 1.8vw, 1.4rem); line-height: 1.8; color: var(--ink); }
  .photo { background: var(--surface); padding: 12px; border-radius: var(--radius); box-shadow: var(--shadow-soft); border: 1px solid var(--line); }
  .photo :global(img) { border-radius: 12px; width: 100%; }
  .photo figcaption { padding: 12px 6px 4px; font-size: 0.88rem; line-height: 1.7; }
</style>
