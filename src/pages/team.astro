---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import team from '../../content/team.json';
import { getImage, hasImage } from '../lib/images';
import { isTodo } from '../lib/text';
const photo = getImage(team.photo.image);
---
<BaseLayout title={team.seo.title} description={team.seo.description}>
  <PageHeader eyebrow={team.about.eyebrow} title={team.about.title} />

  <section class="section">
    <div class="container story">
      <blockquote data-reveal><p>「{team.about.quote}」</p></blockquote>
      <div class="paras">
        {team.about.paragraphs.map((p, i) => <p data-reveal style={`--d:${i * 0.1}s`}>{p}</p>)}
      </div>
    </div>
    <div class="container">
      <figure class="photo" data-reveal>
        <div class="ph"><Image class="settle" src={photo} alt={team.photo.alt} widths={[640, 960, 1400]} sizes="(max-width: 1100px) 92vw, 1000px" /></div>
        <figcaption>{team.photo.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section paper-grid">
    <div class="container">
      <SectionHead eyebrow="TEAM" title={team.membersTitle} />
      <ul class="members">
        {team.members.map((m, i) => {
          // 職責說明開頭的【分類】拆成小標籤顯示（文字內容不變）
          const tagMatch = m.bio.match(/^【(.+?)】(.*)$/);
          return (
            <li class:list={['member', { todo: isTodo(m.name) }]} data-reveal style={`--d:${i * 0.1}s`}>
              <div class="portrait">
                {hasImage(m.photo)
                  ? <Image class="settle" src={getImage(m.photo)} alt={`${m.name}（${m.role}）`} widths={[320, 480, 640]} sizes="(max-width: 720px) 90vw, 380px" />
                  : <span class="mono-initial" aria-hidden="true">{m.name.replace('TODO：', '').slice(0, 1)}</span>}
              </div>
              <div class="info">
                <h3>{m.name}</h3>
                <p class="role">{m.role}</p>
                {tagMatch
                  ? <p class="bio"><span class="tag">{tagMatch[1]}</span>{tagMatch[2]}</p>
                  : <p class="bio">{m.bio}</p>}
              </div>
            </li>
          );
        })}
      </ul>

      {team.showPartners && (
        <div class="partners-wrap">
          <SectionHead eyebrow="PARTNERS" title={team.partnersTitle} />
          <ul class="partners">
            {team.partners.map((p) => (
              <li class:list={['card', { todo: isTodo(p.name) }]} data-reveal>
                <h3>{p.name}</h3>
                <p>{p.role}</p>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .story { display: grid; gap: 32px; }
  @media (min-width: 960px) { .story { grid-template-columns: 1fr 1.1fr; gap: 72px; } }
  blockquote p { font-family: var(--font-display); font-weight: 900; font-size: clamp(1.4rem, 2.4vw, 2rem); line-height: 1.7; color: var(--ink); }
  blockquote { padding-left: 24px; border-left: 4px solid; border-image: var(--brand-grad) 1; }
  .paras { display: grid; gap: 20px; font-size: 1.08rem; }
  .photo { margin-top: clamp(48px, 6vw, 80px); background: var(--surface); padding: 14px; border-radius: var(--radius); border: 1px solid var(--line); box-shadow: var(--shadow-soft); max-width: 1000px; margin-inline: auto; }
  .ph { border-radius: 12px; overflow: hidden; }
  .photo :global(img) { width: 100%; }
  .photo figcaption { padding: 14px 8px 4px; text-align: center; font-size: 0.92rem; }
  .members { list-style: none; padding: 0; margin-top: var(--space-block); display: grid; gap: 24px; }
  @media (min-width: 720px) { .members { grid-template-columns: repeat(3, 1fr); gap: 28px; } }
  .member { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out), border-color 0.4s; }
  .member:hover { transform: translateY(-4px); box-shadow: var(--shadow-soft); border-color: rgba(79, 192, 225, 0.5); }
  .portrait { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--brand-grad); display: grid; place-items: center; }
  .portrait::after { content: ""; position: absolute; inset: auto 0 0 0; height: 30%; background: linear-gradient(transparent, rgba(12, 46, 54, 0.18)); pointer-events: none; }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease-out); }
  .member:hover .portrait :global(img) { transform: scale(1.04); }
  .mono-initial { font-family: var(--font-display); font-weight: 900; font-size: clamp(4rem, 9vw, 6rem); color: rgba(255, 255, 255, 0.92); letter-spacing: 0; }
  .info { padding: 24px 26px 28px; }
  .member h3 { font-family: var(--font-display); font-weight: 900; font-size: 1.4rem; line-height: 1.35; }
  .role { margin-top: 6px; font-size: 0.92rem; font-weight: 700; color: var(--cyan-ink); line-height: 1.6; }
  .bio { margin-top: 14px; font-size: 0.98rem; line-height: 1.85; }
  .tag { display: block; width: fit-content; margin-bottom: 8px; padding: 2px 10px; border-radius: 999px; font-size: 0.82rem; font-weight: 700; color: var(--mint-ink); background: rgba(102, 194, 174, 0.14); }
  .partners-wrap { margin-top: clamp(64px, 8vw, 104px); }
  .partners { list-style: none; padding: 0; margin-top: 32px; display: grid; gap: 14px; }
  @media (min-width: 720px) { .partners { grid-template-columns: repeat(3, 1fr); } }
  .partners li { padding: 22px 24px; }
  .partners h3 { font-size: 1.05rem; }
  .partners p { margin-top: 4px; font-size: 0.95rem; }
</style>
