---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHead from '../components/SectionHead.astro';
import PreventionTimeline from '../components/PreventionTimeline.astro';
import SignalChart from '../components/SignalChart.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import tech from '../../content/technology.json';
import { isTodo } from '../lib/text';
---
<BaseLayout title={tech.seo.title} description={tech.seo.description}>
  <PageHeader eyebrow={tech.eyebrow} title={tech.title} body={tech.body} />

  <section class="section">
    <div class="container two">
      <div>
        <div data-reveal>
          <p class="eyebrow">DISTANCE SENSING</p>
          <h2 class="h2">{tech.comparison.title}<br /><span class="hl">{tech.comparison.highlight}</span></h2>
        </div>
        <ul class="points">
          {tech.comparison.points.map((p, i) => (
            <li data-reveal style={`--d:${i * 0.1}s`}>
              <span class="pi"><Icon name={p.icon} size={22} /></span>
              <span>{p.text}</span>
            </li>
          ))}
        </ul>
      </div>
      <PreventionTimeline />
    </div>
  </section>

  <section class="section on-deep chart-sec">
    <div class="container">
      <div class="chart-wrap" data-reveal>
        <SignalChart />
      </div>
    </div>
  </section>

  <section class="section paper-grid">
    <div class="container">
      <SectionHead eyebrow={tech.flow.eyebrow} title={tech.flow.title} />
      <ol class="flow">
        {tech.flow.steps.map((s, i) => (
          <li class:list={['card', 'lift', { todo: isTodo(s.title) || isTodo(s.text) }]} data-reveal style={`--d:${i * 0.1}s`}>
            <span class="n mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .two { display: grid; gap: clamp(40px, 6vw, 80px); align-items: center; }
  @media (min-width: 960px) { .two { grid-template-columns: 1fr 1.1fr; } }
  .hl { background: linear-gradient(120deg, #0d6a86, #1b6f5b); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .points { list-style: none; padding: 0; margin-top: 32px; display: grid; gap: 20px; }
  .points li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; align-items: start; color: var(--ink); font-size: 1.05rem; }
  .pi { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; background: linear-gradient(135deg, rgba(79, 192, 225, 0.14), rgba(102, 194, 174, 0.14)); border: 1px solid rgba(79, 192, 225, 0.4); color: var(--cyan-ink); }
  .chart-sec { overflow: hidden; }
  .chart-sec::before { content: ""; position: absolute; inset: 0; background: radial-gradient(50vw 50vh at 50% 0%, rgba(79, 192, 225, 0.2), transparent 70%); }
  .chart-wrap { position: relative; max-width: 980px; margin-inline: auto; }
  .flow { list-style: none; padding: 0; margin-top: var(--space-block); display: grid; gap: 18px; counter-reset: s; }
  @media (min-width: 800px) { .flow { grid-template-columns: repeat(3, 1fr); } }
  .flow li { padding: 30px; }
  .n { font-size: 0.85rem; letter-spacing: 0.14em; color: var(--cyan-ink); }
  .flow h3 { margin-top: 14px; font-size: var(--fs-h3); }
  .flow p { margin-top: 8px; }
</style>
