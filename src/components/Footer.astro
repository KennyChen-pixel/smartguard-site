---
import { Image } from 'astro:assets';
import site from '../../content/site.json';
import logo from '../assets/logo.png';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer on-deep">
  <div class="container grid">
    <div class="brand-col">
      <a class="brand" href="/" aria-label={`${site.name} 首頁`}>
        <Image src={logo} alt="" width={40} height={46} densities={[1, 2, 3]} />
        <span>{site.name}<small>{site.nameEn}</small></span>
      </a>
      <a class="li" href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${site.name} LinkedIn 官方頁面（另開新視窗）`}>
        <Icon name="Linkedin" size={20} />
      </a>
    </div>
    <nav aria-label="頁尾導覽">
      <p class="h">網站導覽</p>
      <ul>
        {site.nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={site.navCta.href}>{site.navCta.label}</a></li>
      </ul>
    </nav>
    <div>
      <p class="h">聯絡方式</p>
      <ul class="contact">
        <li><Icon name="Mail" size={18} /><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><Icon name="Phone" size={18} /><a href={`tel:${site.contact.phoneIntl}`}>{site.contact.phone}</a></li>
        <li><Icon name="MapPin" size={18} /><span>{site.contact.address}</span></li>
      </ul>
    </div>
  </div>
  <div class="container">
    <p class="sig display">{site.brandLine}</p>
  </div>
  <div class="container legal">
    <p>© {year} {site.name} {site.nameEn}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { position: relative; padding-top: 72px; overflow: hidden; }
  .site-footer::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--brand-grad); }
  .grid { display: grid; gap: 40px; grid-template-columns: 1fr; }
  .brand-col { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .brand { display: inline-flex; align-items: center; gap: 12px; min-height: 48px; text-decoration: none; color: var(--on-deep); font-weight: 700; font-size: 1.1rem; }
  .brand img { width: 40px; height: auto; }
  .brand small { display: block; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 400; letter-spacing: 0.12em; color: var(--on-deep-soft); }
  /* 頁尾大字品牌收尾：品牌漸層字，隨視窗寬度縮放 */
  .sig {
    margin-top: clamp(48px, 7vw, 88px); white-space: nowrap; line-height: 1.05;
    font-size: clamp(2.6rem, 7.6vw, 7.2rem); letter-spacing: 0.06em;
    background: linear-gradient(120deg, rgba(79, 192, 225, 0.9), rgba(102, 194, 174, 0.55) 60%, rgba(102, 194, 174, 0.2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  @media (max-width: 560px) { .sig { white-space: normal; font-size: clamp(2.8rem, 16vw, 4.4rem); } }
  .li { display: inline-grid; place-items: center; width: 48px; height: 48px; margin-top: 16px; margin-left: -12px; border-radius: 50%; color: var(--on-deep); transition: background 0.2s; }
  .li:hover { background: rgba(255, 255, 255, 0.08); }
  .h { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.14em; color: var(--brand-cyan); margin-bottom: 10px; }
  ul { list-style: none; padding: 0; }
  nav a, .contact a { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; padding: 0 2px; color: var(--on-deep); text-decoration: none; }
  nav a:hover, .contact a:hover { color: var(--brand-cyan); }
  .contact li { display: flex; align-items: center; gap: 12px; color: var(--on-deep); }
  .contact li :global(.icon) { flex: none; color: var(--brand-mint); }
  .contact span { padding: 8px 0; }
  .legal { margin-top: 56px; padding-block: 24px; border-top: 1px solid rgba(234, 245, 244, 0.12); font-size: 0.85rem; }
  @media (min-width: 768px) { .grid { grid-template-columns: 1.4fr 1fr 1.4fr; } }
</style>
