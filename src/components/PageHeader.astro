---
import { richText } from '../lib/text';
interface Props { eyebrow: string; title: string; body?: string }
const { eyebrow, title, body } = Astro.props;
---
<section class="page-head paper-grid">
  <div class="glow" aria-hidden="true"></div>
  <svg class="trace" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 80 L180 80 L196 44 L208 96 L220 80 L420 80 L436 50 L448 94 L460 80 L660 80 L676 40 L688 98 L700 80 L900 80 L916 52 L928 92 L940 80 L1200 80" />
  </svg>
  <div class="container inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="display">{title}</h1>
    {body && <p class="lede" set:html={richText(body)} />}
    <slot />
  </div>
</section>
<style>
  .page-head { position: relative; overflow: hidden; padding: clamp(56px, 9vw, 112px) 0 clamp(80px, 9vw, 120px); border-bottom: 1px solid var(--line); }
  .glow { position: absolute; inset: 0; background: radial-gradient(50vw 40vh at 88% 0%, var(--warm-glow), transparent 70%), radial-gradient(40vw 40vh at 0% 100%, rgba(102, 194, 174, 0.14), transparent 70%); }
  .inner { position: relative; }
  h1 { font-size: clamp(2.2rem, 5vw, 4.2rem); margin-top: var(--space-eyebrow); letter-spacing: 0.03em; }
  .trace { position: absolute; left: 0; right: 0; bottom: 8px; width: 100%; height: 56px; opacity: 0.55; }
  .trace path { fill: none; stroke: var(--brand-cyan); stroke-width: 1.6; stroke-dasharray: 2600; stroke-dashoffset: 2600; animation: sg-draw 2.6s var(--ease-out) 0.2s forwards; vector-effect: non-scaling-stroke; }
  @keyframes sg-draw { to { stroke-dashoffset: 0; } }
</style>
