---
// 線條圖示（24×24、stroke 風格）。新增圖示：在 paths 加一組即可。
interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 24, class: cls = '', label } = Astro.props;

const paths: Record<string, string> = {
  Radio: '<circle cx="12" cy="12" r="2"/><path d="M16.2 7.8a6 6 0 0 1 0 8.4M7.8 16.2a6 6 0 0 1 0-8.4M19 5a10 10 0 0 1 0 14M5 19A10 10 0 0 1 5 5"/>',
  Shield: '<path d="M12 3 4.5 6v5.5c0 4.6 3.1 8 7.5 9.5 4.4-1.5 7.5-4.9 7.5-9.5V6z"/><path d="m8.8 12 2.2 2.2 4.4-4.4"/>',
  Cpu: '<rect x="5" y="5" width="14" height="14" rx="2"/><rect x="9" y="9" width="6" height="6" rx="1"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
  Award: '<circle cx="12" cy="9" r="6"/><path d="m8.5 14 -1.5 8 5-3 5 3-1.5-8"/>',
  Medal: '<circle cx="12" cy="15" r="6"/><path d="M8 3h8l-2 6h-4zM12 12.5v5M10 15h4"/>',
  FileBadge: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><circle cx="12" cy="14" r="3"/><path d="m10.5 16.5-.8 4 2.3-1.2 2.3 1.2-.8-4"/>',
  Eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  HeartHandshake: '<path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 1 1 12 6.1a5 5 0 1 1 7.5 6.5z"/><path d="M12 6.1 9 9.2a2 2 0 0 0 2.8 2.8l1.3-1.2 2.4 2.4"/>',
  Mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  Phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>',
  MapPin: '<path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/>',
  Linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  ArrowUpRight: '<path d="M7 17 17 7M8 7h9v9"/>',
  ArrowRight: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  ArrowDown: '<path d="M12 5v14M6 13l6 6 6-6"/>',
  Check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  CheckCircle: '<circle cx="12" cy="12" r="10"/><path d="m7.5 12.5 3 3 6-6"/>',
  AlertCircle: '<circle cx="12" cy="12" r="10"/><path d="M12 7v6M12 16.5v.5"/>',
  Menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  X: '<path d="M6 6l12 12M18 6 6 18"/>',
  Plus: '<path d="M12 5v14M5 12h14"/>',
  Send: '<path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/>',
  Refresh: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>',
};
const body = paths[name] ?? paths.Radio;
---
<svg
  class={`icon ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={body}
/>
